    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Initial setup\n",
    "initial_elo = 1000\n",
    "elo_ratings = {team: initial_elo for team in teams_in_asia}\n",
    "\n",
    "def calculate_elo(df, teams_list):\n",
    "    # Ensure chronological order\n",
    "    df = df.sort_values('date').copy()\n",
    "    \n",
    "    # Storage for ratings over time if you want to track progress\n",
    "    # Initializing current ratings\n",
    "    current_ratings = {team: 1000.0 for team in teams_list}\n",
    "    \n",
    "    for index, row in df.iterrows():\n",
    "        home_team = row['home_team']\n",
    "        away_team = row['away_team']\n",
    "        \n",
    "        # Only process if both teams are in our target list\n",
    "        if home_team in current_ratings and away_team in current_ratings:\n",
    "            # 1. Get current ratings (Ro)\n",
    "            r_home = current_ratings[home_team]\n",
    "            r_away = current_ratings[away_team]\n",
    "            \n",
    "            # 2. Calculate Expected Result (We)\n",
    "            # dr = difference in ratings + 100 for home advantage\n",
    "            dr = (r_home + 100) - r_away\n",
    "            we_home = 1 / (10**(-dr / 400) + 1)\n",
    "            we_away = 1 - we_home\n",
    "            \n",
    "            # 3. Determine Result (W)\n",
    "            if row['home_score'] > row['away_score']:\n",
    "                w_home, w_away = 1, 0\n",
    "            elif row['home_score'] < row['away_score']:\n",
    "                w_home, w_away = 0, 1\n",
    "            else:\n",
    "                w_home, w_away = 0.5, 0.5\n",
    "                \n",
    "            # 4. Calculate Goal Difference Index (G)\n",
    "            n = abs(row['home_score'] - row['away_score'])\n",
    "            if n <= 1:\n",
    "                g = 1\n",
    "            elif n == 2:\n",
    "                g = 1.5\n",
    "            elif n == 3:\n",
    "                g = 2\n",
    "            elif n == 4:\n",
    "                g = 2.25\n",
    "            else:\n",
    "                g = 1.75 + n / 8\n",
    "                \n",
    "            # 5. Get Tournament Weight (K)\n",
    "            k = tournament_weight(row['tournament'])\n",
    "            \n",
    "            # 6. Calculate Points Change (P)\n",
    "            # P = K * G * (W - We)\n",
    "            p_home = k * g * (w_home - we_home)\n",
    "            p_away = k * g * (w_away - we_away)\n",
    "            \n",
    "            # 7. Update Ratings (Rn = Ro + P)\n",
    "            current_ratings[home_team] += p_home\n",
    "            current_ratings[away_team] += p_away\n",
    "\n",
    "    return current_ratings\n",
    "\n",
    "# Execute\n",
    "final_ratings = calculate_elo(afc_matches_since_2000, teams_in_asia)\n",
    "\n",
